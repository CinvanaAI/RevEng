# RevEng environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.

# --- Required ---
# OpenAI-compatible API key
OPENAI_API_KEY=

# --- Optional: LLM configuration ---
# Model to use for inference (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# API endpoint — override for local models (LM Studio, Ollama proxies, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional: Runtime paths ---
# Absolute path to the SQLite database file.
# Default: ./reveng_platform.db (relative to cwd for server.py, data dir for desktop)
REVENG_DB=

# Set automatically by the desktop launcher to the user data directory.
# Rarely needed when running via server.py.
REVENG_LAUNCHER_ROOT=

# Path to the .env file loaded at startup. Set by the desktop launcher.
REVENG_ENV_FILE=

# Path to the capability environment skin asset directory.
# Set automatically by the desktop launcher from packaged assets.
REVENG_CAPABILITY_ENV_ASSET_DIR=
